          "type": "single_choice",
          "language": "javascript",
          "difficulty": "medium",
          "points": 1,
          "content_markdown": "What is a common responsibility of middleware in a state pipeline?",
          "options": [
            {
              "key": "A",
              "text": "Intercept actions before reducers"
            },
            {
              "key": "B",
              "text": "Render every DOM element"
            },
            {
              "key": "C",
              "text": "Compile CSS"
            },
            {
              "key": "D",
              "text": "Replace the event loop"
            }
          ],
          "correct_keys": [
            "A"
          ],
          "explanation": "Middleware can inspect, transform, delay, or trigger work around actions.",
          "reference_url": "https://redux.js.org/usage"
        },
